generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(uuid())
  googleId        String           @unique
  name            String
  email           String           @unique
  avatar          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  campaigns       Campaign[]
  senders         Sender[]
  slackConnection SlackConnection?
}

model Sender {
  id               String     @id @default(uuid())
  userId           String
  email            String
  etherealUser     String
  etherealPassword String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  campaigns        Campaign[]
  emails           Email[]
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@index([userId])
}

model Campaign {
  id           String   @id @default(uuid())
  userId       String
  senderId     String
  subject      String
  body         String
  startTime    DateTime
  delaySeconds Int      @default(0)
  hourlyLimit  Int      @default(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sender       Sender   @relation(fields: [senderId], references: [id])
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails       Email[]

  @@index([userId])
  @@index([senderId])
}

model Email {
  id          String      @id @default(uuid())
  campaignId  String
  senderId    String
  recipient   String
  subject     String
  body        String
  scheduledAt DateTime
  sentAt      DateTime?
  status      EmailStatus @default(SCHEDULED)
  bullJobId   String?
  messageId   String?
  attempts    Int         @default(0)
  error       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  campaign    Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender      Sender      @relation(fields: [senderId], references: [id])

  @@index([campaignId])
  @@index([senderId])
  @@index([recipient])
  @@index([status])
  @@index([scheduledAt])
  @@index([sentAt])
}

model SlackConnection {
  id          String   @id @default(uuid())
  userId      String   @unique
  accessToken String
  teamId      String?
  teamName    String?
  channelId   String?
  channelName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}
